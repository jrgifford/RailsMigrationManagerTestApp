<h1>Migrations</h1>

<%= link_to 'Refresh', migrations_path, class: 'button' %>

<table>
  <thead>
    <tr>
      <th>Filename</th>
      <th>Version</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @pending.each do |migration| %>
      <tr>
        <td><%= migration[:filename] %></td>
        <td><%= migration[:version] %></td>
        <td><span class="badge badge-pending">Pending</span></td>
        <td>
          <%= button_to 'Run', run_migrations_path, method: :post, params: { version: migration[:version] }, class: 'button run-button' %>
          <%= button_to 'Skip', skip_migrations_path, method: :post, params: { version: migration[:version], reason: 'Skipped via UI' }, class: 'button skip-button' %>
        </td>
      </tr>
    <% end %>

    <% @applied.each do |version| %>
      <tr>
        <td>—</td>
        <td><%= version %></td>
        <td><span class="badge badge-applied">Applied</span></td>
        <td>—</td>
      </tr>
    <% end %>

    <% @skipped.each do |skipped| %>
      <tr>
        <td><%= skipped.is_a?(String) ? skipped : skipped.filename %></td>
        <td><%= skipped.is_a?(String) ? skipped : skipped.version %></td>
        <td><span class="badge badge-skipped">Skipped</span></td>
        <td>—</td>
      </tr>
    <% end %>
  </tbody>
</table>
